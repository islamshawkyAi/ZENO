{
  "expo": {
    "name": "ZENO",
    "slug": "zeno",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.zeno.social",
      "adaptiveIcon": {
        "backgroundColor": "#090B16"
      },
      "splash": {
        "backgroundColor": "#03040B",
        "resizeMode": "contain"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "يسمح ZENO باستخدام الكاميرا لإجراء مكالمات الفيديو.",
          "microphonePermission": "يسمح ZENO باستخدام الميكروفون لإجراء المكالمات الصوتية والفيديو.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#03040B",
      "resizeMode": "contain"
    }
  }
}
